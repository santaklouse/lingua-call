{
  "name": "linguacall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P2P video calls with real-time speech translation, entirely in the browser",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "cd apps/web && bun x --bun vite",
    "build": "cd apps/web && bun x --bun vite build",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "lint": "bun x eslint .",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
