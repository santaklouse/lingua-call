{
  "name": "linguacall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P2P video calls with real-time speech translation, entirely in the browser",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @linguacall/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "@types/node": "^24.10.1",
    "globals": "^16.5.0",
    "jsdom": "^28.0.1",
    "@testing-library/react": "^16.3.2"
  }
}
